# Example only. Store actual values in your secret manager, never in Git.
# DNS A/AAAA must point at your staging server.
FORM_STAGE_DOMAIN=stage.example.com
# Generate locally: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FORM_SESSION_SECRET=REPLACE_WITH_A_NEW_LONG_RANDOM_SECRET
# Caddy basic-auth hash (NOT the plaintext password):
# docker run --rm caddy:2.9-alpine caddy hash-password --plaintext 'LONG_UNIQUE_PILOT_PASSWORD'
FORM_PILOT_ACCESS_HASH=REPLACE_WITH_BCRYPT_HASH
# Required for hosted account registration. Use a different secret from Caddy access.
# Generate locally: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank until provisioning; compose refuses to start with an empty value.
FORM_PILOT_INVITE_CODE=
