# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
FORM_SESSION_SECRET=replace-me-with-strong-secret
FORM_DATA_DIR=./data
# Set true behind correctly configured HTTPS reverse proxy:
FORM_COOKIE_SECURE=false

# Sets startup security checks. Do not turn on until fully hardened.
FORM_ENV=development
