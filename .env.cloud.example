# Example only. NEVER commit a populated .env file or paste these secrets into chat.
FORM_ENV=staging
FORM_CLOUD_MODE=true
FORM_DATABASE_URL=postgresql://user:password@private-postgres:5432/form_staging
FORM_PHOTO_STORAGE=s3
FORM_S3_BUCKET=private-form-staging
FORM_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
FORM_S3_REGION=auto
FORM_S3_ACCESS_KEY_ID=REPLACE_IN_HOST_SECRET_MANAGER
FORM_S3_SECRET_ACCESS_KEY=REPLACE_IN_HOST_SECRET_MANAGER
FORM_S3_PREFIX=staging
FORM_DATA_DIR=/tmp/form-runtime
FORM_COOKIE_SECURE=true
FORM_SESSION_SECRET=REPLACE_WITH_48_PLUS_RANDOM_CHARACTERS
FORM_PILOT_INVITE_CODE=REPLACE_WITH_LONG_UNPREDICTABLE_CODE
FORM_ALLOWED_HOSTS=stage.example.com
FORM_PUBLIC_ORIGIN=https://stage.example.com

# v0.7: disabled by default on hosted staging until secure mail is configured.
FORM_RECOVERY_MODE=disabled
# When available, switch to smtp and set these in Render's secret manager:
# FORM_SMTP_HOST=...
# FORM_SMTP_PORT=465
# FORM_SMTP_USERNAME=...
# FORM_SMTP_PASSWORD=...
# FORM_SMTP_FROM=...
