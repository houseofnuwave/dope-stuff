# FORM v0.7 example. This is NOT a live secret file.
# Offline Mac pilot default: local private recovery mail spool.
FORM_RECOVERY_MODE=local
# Hosted staging is DISABLED by default. Configure sender when ready:
# FORM_RECOVERY_MODE=smtp
# FORM_SMTP_HOST=smtp.example.net
# FORM_SMTP_PORT=465
# FORM_SMTP_USERNAME=FROM_SECURE_SECRET_MANAGER
# FORM_SMTP_PASSWORD=FROM_SECURE_SECRET_MANAGER
# FORM_SMTP_FROM=accounts@example.net
# FORM_PUBLIC_ORIGIN=https://verified-stage-domain.example
# Never commit real credentials or expose recovery links in issue trackers.
